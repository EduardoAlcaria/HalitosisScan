<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram id="hality" name="Hality — Arquitetura">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2336" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Hality — triagem de indício de halitose por imagem da língua" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F2933;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Ferramenta de triagem com encaminhamento. Não é diagnóstico. Alvo binário: nota clínica 3 contra o resto." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#616E7C;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="900" height="20" as="geometry" />
        </mxCell>

        <!-- ============ TREINO ============ -->
        <mxCell id="boxTreino" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#CBD2D9;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#3E4C59;" vertex="1" parent="1">
          <mxGeometry x="40" y="95" width="1540" height="290" as="geometry" />
        </mxCell>
        <mxCell id="lblTreino" value="FLUXO DE TREINO — executado uma vez, offline" style="text;html=1;fontSize=13;fontStyle=1;align=left;fontColor=#3E4C59;" vertex="1" parent="1">
          <mxGeometry x="52" y="102" width="500" height="20" as="geometry" />
        </mxCell>

        <mxCell id="t1" value="&lt;b&gt;Dados brutos&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;323 fotos clínicas (PUCRS)&lt;br/&gt;345 anamneses, nota 1–3&lt;br/&gt;jpg / bmp / heic / png&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4E7EB;strokeColor=#9AA5B1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="150" width="180" height="90" as="geometry" />
        </mxCell>

        <mxCell id="t2" value="&lt;b&gt;Auditoria de confundidor&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;prever rótulo só com&lt;br/&gt;largura, altura, bytes, extensão&lt;br/&gt;&lt;b&gt;próprio: AUC 0,498 ✓&lt;/b&gt;&lt;br/&gt;chinês: AUC 0,995 ✗&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3C4;strokeColor=#F0B429;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="290" y="150" width="190" height="90" as="geometry" />
        </mxCell>

        <mxCell id="t3" value="&lt;b&gt;Tabela mestra + divisão&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;filtra máscara &amp;lt; 0,15 → 306 úteis&lt;br/&gt;estratificada, &lt;b&gt;por paciente&lt;/b&gt;&lt;br/&gt;213 treino / 45 val / 48 teste&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4E7EB;strokeColor=#9AA5B1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="520" y="150" width="200" height="90" as="geometry" />
        </mxCell>

        <mxCell id="t4a" value="&lt;b&gt;Segmentador&lt;/b&gt; · U-Net 483k par.&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;192×192, Dice+BCE, só partição treino&lt;br/&gt;aug. geométrica · &lt;b&gt;IoU 0,842&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F0FF;strokeColor=#2186EB;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="770" y="126" width="290" height="52" as="geometry" />
        </mxCell>
        <mxCell id="t4b" value="&lt;b&gt;Modelo A · Gate&lt;/b&gt; · DINOv2 + logreg&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;2.331 línguas vs 5.000 COCO, imagem inteira&lt;br/&gt;&lt;b&gt;recall 97,8% · falso-aceite 0,0%&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F0FF;strokeColor=#2186EB;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="770" y="186" width="290" height="52" as="geometry" />
        </mxCell>
        <mxCell id="t4c" value="&lt;b&gt;Modelo B · Classificador&lt;/b&gt; · HistGB + isotônica&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;34 features sobre máscara &lt;i&gt;prevista&lt;/i&gt;&lt;br/&gt;&lt;b&gt;AUC 0,797 [0,779–0,820]&lt;/b&gt; (CV 5×10)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F0FF;strokeColor=#2186EB;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="770" y="246" width="290" height="52" as="geometry" />
        </mxCell>

        <mxCell id="t5" value="&lt;b&gt;Calibração na VALIDAÇÃO&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;limiar (sens ≥ 0,85)&lt;br/&gt;ruído medido → faixa de abstenção&lt;br/&gt;limiares de qualidade&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3C4;strokeColor=#F0B429;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1100" y="150" width="190" height="90" as="geometry" />
        </mxCell>

        <mxCell id="t6" value="&lt;b&gt;models/&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;segmentador.pt&lt;br/&gt;gate.pkl&lt;br/&gt;classificador.pkl&lt;br/&gt;sam/ (ViT-B + ONNX)&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#D9E2EC;strokeColor=#627D98;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1340" y="145" width="150" height="100" as="geometry" />
        </mxCell>

        <mxCell id="t7" value="&lt;b&gt;TESTE TRANCADO&lt;/b&gt; · aberto uma vez&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;n=48 · AUC 0,878 · sens 0,964 · espec 0,400&lt;br/&gt;referências: baseline F1 0,368 · anamnese AUC 0,615&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE3E3;strokeColor=#E12D39;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="520" y="290" width="500" height="60" as="geometry" />
        </mxCell>

        <mxCell id="et12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#627D98;" edge="1" parent="1" source="t1" target="t2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="et23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#627D98;" edge="1" parent="1" source="t2" target="t3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="et3a" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#627D98;" edge="1" parent="1" source="t3" target="t4a"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="et3b" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#627D98;" edge="1" parent="1" source="t3" target="t4b"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="et3c" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#627D98;" edge="1" parent="1" source="t3" target="t4c"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="etc5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#627D98;" edge="1" parent="1" source="t4c" target="t5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="et56" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#627D98;" edge="1" parent="1" source="t5" target="t6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="et37" value="usado 1x ao final" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#E12D39;fontSize=10;fontColor=#E12D39;" edge="1" parent="1" source="t3" target="t7"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ============ INFERENCIA ============ -->
        <mxCell id="boxInf" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#CBD2D9;dashed=1;verticalAlign=top;align=left;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="410" width="1540" height="940" as="geometry" />
        </mxCell>
        <mxCell id="lblInf" value="FLUXO DE INFERÊNCIA — por foto · POST /analisar" style="text;html=1;fontSize=13;fontStyle=1;align=left;fontColor=#3E4C59;" vertex="1" parent="1">
          <mxGeometry x="52" y="417" width="600" height="20" as="geometry" />
        </mxCell>

        <mxCell id="i0" value="&lt;b&gt;foto&lt;/b&gt; (bytes) &lt;font style=&quot;font-size:11px&quot;&gt;· jpg / png / bmp / heic · ≤ 20 MB&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4E7EB;strokeColor=#9AA5B1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="455" width="330" height="40" as="geometry" />
        </mxCell>

        <mxCell id="i1" value="&lt;b&gt;1 · normalize&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;decodifica · corrige EXIF · reamostra preservando proporção (lado máx. 1024)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4E7EB;strokeColor=#9AA5B1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="520" width="330" height="52" as="geometry" />
        </mxCell>

        <mxCell id="loop" value="&lt;b&gt;⟳ 5 PASSAGENS&lt;/b&gt; sobre variantes geométricas da mesma foto (recorte ≤7%, rotação ±5°, espelhamento). Sem jitter de cor: a cor é o sinal." style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#7B61FF;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontColor=#5B34D6;" vertex="1" parent="1">
          <mxGeometry x="180" y="595" width="700" height="470" as="geometry" />
        </mxCell>

        <mxCell id="i2" value="&lt;b&gt;2 · image_quality&lt;/b&gt; &lt;font style=&quot;font-size:10px&quot;&gt;(lógica pura)&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;exposição ANTES de nitidez (foto escura tem pouco contraste)&lt;br/&gt;var. do Laplaciano · fração estourada / colada no preto&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3C4;strokeColor=#F0B429;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="645" width="330" height="60" as="geometry" />
        </mxCell>

        <mxCell id="i3" value="&lt;b&gt;3 · tongue_gate&lt;/b&gt; &lt;font style=&quot;font-size:10px&quot;&gt;(Modelo A)&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;DINOv2-small → 768-d → logreg&lt;br/&gt;limiar calibrado nas fotos próprias&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F0FF;strokeColor=#2186EB;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="730" width="330" height="60" as="geometry" />
        </mxCell>

        <mxCell id="i4" value="&lt;b&gt;4 · segment&lt;/b&gt; &lt;font style=&quot;font-size:10px&quot;&gt;(cascata)&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;U-Net → se área &amp;lt; 0,20, resgate por realce de contraste&lt;br/&gt;realce só para segmentar, nunca para extrair features&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F0FF;strokeColor=#2186EB;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="815" width="330" height="60" as="geometry" />
        </mxCell>

        <mxCell id="i5" value="&lt;b&gt;5 · mask_sanity&lt;/b&gt; &lt;font style=&quot;font-size:10px&quot;&gt;(lógica pura)&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;área ≥ 0,12 · maior componente ≥ 55% da máscara&lt;br/&gt;&lt;b&gt;sem limite superior:&lt;/b&gt; máscara de 70% é close-up legítimo&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3C4;strokeColor=#F0B429;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="900" width="330" height="60" as="geometry" />
        </mxCell>

        <mxCell id="i6" value="&lt;b&gt;6 · extract&lt;/b&gt; → vetor de 34 features&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;só DENTRO da máscara · RGB e HSV (média, desvio, p10, p90)&lt;br/&gt;textura · setor ponta/meio/base&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4E7EB;strokeColor=#9AA5B1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="985" width="330" height="60" as="geometry" />
        </mxCell>

        <mxCell id="i7" value="&lt;b&gt;7 · predict&lt;/b&gt; &lt;font style=&quot;font-size:10px&quot;&gt;(Modelo B)&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;HistGradientBoosting + calibração isotônica&lt;br/&gt;probabilidade recortada em [0,02 – 0,98]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F0FF;strokeColor=#2186EB;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="1090" width="330" height="60" as="geometry" />
        </mxCell>

        <mxCell id="i8" value="&lt;b&gt;8 · decide&lt;/b&gt; — voto de maioria sobre as 5 passagens&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;sem maioria clara → inconclusivo (a discordância É a resposta)&lt;br/&gt;faixa de abstenção = limiar ± 2·ruído medido (0,043)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE8FF;strokeColor=#5B34D6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="1180" width="390" height="60" as="geometry" />
        </mxCell>

        <mxCell id="o1" value="&lt;b&gt;sem_indicio&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C1EAC5;strokeColor=#2F8132;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="180" y="1285" width="150" height="40" as="geometry" />
        </mxCell>
        <mxCell id="o2" value="&lt;b&gt;inconclusivo&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3C4;strokeColor=#F0B429;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="1285" width="150" height="40" as="geometry" />
        </mxCell>
        <mxCell id="o3" value="&lt;b&gt;indicio&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCDBA4;strokeColor=#C99A2E;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="660" y="1285" width="150" height="40" as="geometry" />
        </mxCell>

        <!-- rejeicoes -->
        <mxCell id="r2" value="&lt;b&gt;rejeitado&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&quot;muito escura&quot; / &quot;muito clara&quot; / &quot;tremida&quot;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE3E3;strokeColor=#E12D39;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="930" y="645" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="&lt;b&gt;rejeitado&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&quot;não identifiquei uma língua&quot;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE3E3;strokeColor=#E12D39;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="930" y="730" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r5" value="&lt;b&gt;rejeitado&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&quot;aproxime a câmera&quot; / &quot;não consegui delimitar&quot;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE3E3;strokeColor=#E12D39;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="930" y="900" width="250" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e01" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#627D98;" edge="1" parent="1" source="i0" target="i1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#627D98;" edge="1" parent="1" source="i1" target="i2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#627D98;" edge="1" parent="1" source="i2" target="i3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e34" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#627D98;" edge="1" parent="1" source="i3" target="i4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e45" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#627D98;" edge="1" parent="1" source="i4" target="i5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e56" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#627D98;" edge="1" parent="1" source="i5" target="i6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e67" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#627D98;" edge="1" parent="1" source="i6" target="i7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e78" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#627D98;" edge="1" parent="1" source="i7" target="i8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8o1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2F8132;" edge="1" parent="1" source="i8" target="o1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8o2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C99A2E;" edge="1" parent="1" source="i8" target="o2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8o3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C99A2E;" edge="1" parent="1" source="i8" target="o3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2r" value="✗" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E12D39;fontSize=14;fontColor=#E12D39;" edge="1" parent="1" source="i2" target="r2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3r" value="✗" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E12D39;fontSize=14;fontColor=#E12D39;" edge="1" parent="1" source="i3" target="r3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5r" value="✗" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E12D39;fontSize=14;fontColor=#E12D39;" edge="1" parent="1" source="i5" target="r5"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="usaModelo" value="carrega" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#9AA5B1;fontSize=10;" edge="1" parent="1" source="t6" target="i0"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ============ NOTAS ============ -->
        <mxCell id="notas" value="&lt;b&gt;LIMITES CONHECIDOS&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Teto teórico.&lt;/b&gt; Literatura: saburra × VSC = ρ 0,44 → AUC ≈ 0,70–0,80. Estamos no teto.&lt;br/&gt;10–20% da halitose é extra-oral, invisível em qualquer foto de língua.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Constância.&lt;/b&gt; Mesma língua refotografada muda de veredito em &lt;b&gt;23,3%&lt;/b&gt; das vezes&lt;br/&gt;(era 48,3% antes do voto por maioria). Principal item aberto.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Especificidade 0,400.&lt;/b&gt; De 20 sem indício, 12 são sinalizadas.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Visão computacional atrás do estado da arte.&lt;/b&gt; SM-Tongue: 0,97–0,98 mIoU. Nosso: 0,842.&lt;br/&gt;&lt;br/&gt;&lt;b/&gt;&lt;b&gt;Ambiente único.&lt;/b&gt; Todas as fotos vêm de uma clínica. Captura doméstica não representada.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;PENDÊNCIA Nº 1: protocolo do rótulo.&lt;/b&gt; Não sabemos se a nota 1–3 veio de halímetro,&lt;br/&gt;teste organoléptico ou impressão clínica. Se o avaliador olhou a língua, parte do&lt;br/&gt;resultado é circular. É uma pergunta de e-mail e define o que o produto pode afirmar." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E12D39;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1220" y="1000" width="360" height="330" as="geometry" />
        </mxCell>

        <mxCell id="rejeitados" value="&lt;b&gt;VPP depende da prevalência&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;clínica (58%), sens 0,90 → &lt;b&gt;VPP 0,76&lt;/b&gt;&lt;br/&gt;população aberta (20%) → &lt;b&gt;VPP 0,36&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Aritmética de triagem. Nenhum ganho de AUC&lt;br/&gt;contorna. Por isso: &quot;indício, procure um dentista&quot;.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F0B429;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1220" y="860" width="360" height="120" as="geometry" />
        </mxCell>

